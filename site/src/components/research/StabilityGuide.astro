---
interface StabilityClass {
  className: string;
  label: string;
  threshold: string;
}

interface ForecastCase {
  name: string;
  model: string;
  validAt: string;
  note: string;
  heights: number[];
  lapses: number[];
  launchM: number;
  thermalVelocityMs: number;
  usableLiftTopM: number | null;
  cloudBaseM?: number;
  precipitationMm?: number;
}

const stabilityClasses: StabilityClass[] = [
  { className: "very-unstable", label: "Very unstable", threshold: "≤ −3.0" },
  { className: "unstable", label: "Unstable", threshold: "≤ −2.5" },
  { className: "conditional-strong", label: "Conditional · strong", threshold: "≤ −2.0" },
  { className: "conditional", label: "Conditional", threshold: "≤ −1.5" },
  { className: "near-neutral", label: "Near neutral", threshold: "≤ −1.2" },
  { className: "stable", label: "Stable", threshold: "≤ 0" },
  { className: "inverted", label: "Inversion", threshold: "≤ +0.5" },
  { className: "strong-inversion", label: "Strong inversion", threshold: "> +0.5" },
];

const forecasts: ForecastCase[] = [
  {
    name: "Morning inversion",
    model: "GFS",
    validAt: "2026-08-08 15Z",
    note: "Positive layer near the surface",
    heights: [1017, 1503, 2020, 2565, 3141, 3749, 4398],
    lapses: [0.91, -0.73, -1.85, -2.27, -1.72, -2.07],
    launchM: 1591,
    thermalVelocityMs: 0,
    usableLiftTopM: null,
  },
  {
    name: "Deep dry column",
    model: "HRDPS",
    validAt: "2026-08-08 21Z",
    note: "Near −3 through 2,583 m",
    heights: [1259, 1513, 2036, 2583, 3157, 3763, 4408],
    lapses: [-3.08, -3.04, -3.05, -2.56, -2.05, -2.09],
    launchM: 1485,
    thermalVelocityMs: 2.77,
    usableLiftTopM: 3937,
  },
  {
    name: "Stable lid",
    model: "GFS",
    validAt: "2026-08-14 18Z",
    note: "Unstable lower column",
    heights: [1519, 2034, 2571, 3136, 3733, 4371],
    lapses: [-3.12, -2.96, -2.81, -1.09, -1.61],
    launchM: 1485,
    thermalVelocityMs: 2.47,
    usableLiftTopM: 3443,
    cloudBaseM: 3443,
  },
  {
    name: "Wet stable column",
    model: "GDPS",
    validAt: "2026-08-13 21Z",
    note: "10.54 mm liquid equivalent / 3 h",
    heights: [1247, 1489, 1993, 2525, 3087, 3684, 4317],
    lapses: [-1.99, -1.51, -1.28, -1.75, -1.99, -2.12],
    launchM: 1247,
    thermalVelocityMs: 0.54,
    usableLiftTopM: 1212,
    precipitationMm: 10.54,
  },
];

function classify(lapse: number) {
  if (lapse <= -3) return "very-unstable";
  if (lapse <= -2.5) return "unstable";
  if (lapse <= -2) return "conditional-strong";
  if (lapse <= -1.5) return "conditional";
  if (lapse <= -1.2) return "near-neutral";
  if (lapse <= 0) return "stable";
  if (lapse <= 0.5) return "inverted";
  return "strong-inversion";
}

const width = 1040;
const chartTop = 112;
const chartBottom = 486;
const altitudeMin = 1000;
const altitudeMax = 4500;
const y = (altitudeM: number) =>
  chartBottom - ((altitudeM - altitudeMin) / (altitudeMax - altitudeMin)) * (chartBottom - chartTop);
const columnCenters = [190, 426, 662, 898];
const columnWidth = 112;
const altitudeTicks = [1000, 1500, 2000, 2500, 3000, 3500, 4000, 4500];
const signed = (value: number) => `${value > 0 ? "+" : ""}${value.toFixed(2)}`;
---

<figure class="stability-guide" aria-labelledby="stability-guide-title stability-guide-caption">
  <header>
    <h3 id="stability-guide-title">Read stability as a vertical sequence</h3>
    <p>
      Each printed value is temperature change in °C per 1,000 ft of ascent. Negative values cool
      with height; about −3 follows the dry-adiabatic rate. A positive value marks an inversion:
      temperature rises with height.
    </p>
  </header>

  <div class="profile-scroll" tabindex="0" aria-label="Scrollable comparison of four vertical stability profiles">
    <svg viewBox={`0 0 ${width} 590`} role="img" aria-labelledby="stability-svg-title stability-svg-desc">
      <title id="stability-svg-title">Four forecast stability profiles on one altitude scale</title>
      <desc id="stability-svg-desc">
        The first column has a strong morning inversion near the surface. The second has a deep
        dry-adiabatic lower column. The third has an unstable lower column capped by a stable lid.
        The fourth is stable to conditionally unstable through a wet column. Every coloured
        interval is labelled with its lapse value.
      </desc>
      <defs>
        {stabilityClasses.map((entry, index) => (
          <pattern id={`stability-pattern-${entry.className}`} width="10" height="10" patternUnits="userSpaceOnUse" patternTransform={index % 2 === 0 ? "rotate(28)" : "rotate(-28)"}>
            <line x1="0" y1="0" x2="0" y2="10" class={`pattern-line density-${index % 4}`} />
            {index % 3 === 0 && <line x1="5" y1="0" x2="5" y2="10" class="pattern-line light" />}
          </pattern>
        ))}
      </defs>

      <g class="altitude-grid" aria-hidden="true">
        {altitudeTicks.map((altitude) => (
          <>
            <line x1="77" y1={y(altitude)} x2="970" y2={y(altitude)} />
            <text x="67" y={y(altitude) + 4}>{altitude.toLocaleString("en-CA")} m</text>
          </>
        ))}
      </g>

      {forecasts.map((forecast, forecastIndex) => {
        const center = columnCenters[forecastIndex];
        const left = center - columnWidth / 2;
        const launchY = y(forecast.launchM);
        const usableY = forecast.usableLiftTopM == null ? null : y(forecast.usableLiftTopM);
        return (
          <g class="forecast-profile">
            <text x={center} y="28" class="scenario-name">{forecast.name}</text>
            <text x={center} y="48" class="model-time">{forecast.model} · {forecast.validAt}</text>
            <text x={center} y="70" class="case-note">{forecast.note}</text>

            {forecast.lapses.map((lapse, levelIndex) => {
              const lowerM = forecast.heights[levelIndex];
              const upperM = forecast.heights[levelIndex + 1];
              const top = y(upperM);
              const bottom = y(lowerM);
              const className = classify(lapse);
              return (
                <g>
                  <title>{`${lowerM}–${upperM} m: ${signed(lapse)} °C per 1,000 ft`}</title>
                  <rect x={left} y={top} width={columnWidth} height={bottom - top} class={`stability-fill ${className}`} />
                  <rect x={left} y={top} width={columnWidth} height={bottom - top} fill={`url(#stability-pattern-${className})`} class="pattern-overlay" />
                  <text x={center} y={(top + bottom) / 2 + 4} class="lapse-value">{signed(lapse)}</text>
                </g>
              );
            })}

            <line x1={left - 9} y1={launchY} x2={left + columnWidth + 9} y2={launchY} class="launch-marker" />
            <path d={`M${left - 9} ${launchY} l-8 -5 v10 z`} class="launch-arrow" />
            <text x={left - 21} y={launchY + 4} class="height-note" text-anchor="end">launch {forecast.launchM.toLocaleString("en-CA")}</text>

            {usableY != null && forecast.usableLiftTopM! >= altitudeMin && (
              <>
                <line x1={left - 5} y1={usableY} x2={left + columnWidth + 5} y2={usableY} class="usable-marker" />
                <text x={left + columnWidth + 9} y={usableY + 4} class="height-note">usable {forecast.usableLiftTopM!.toLocaleString("en-CA")}</text>
              </>
            )}

            <text x={center} y="526" class="metric">w* {forecast.thermalVelocityMs.toFixed(2)} m/s</text>
            <text x={center} y="547" class="metric-detail">
              {forecast.usableLiftTopM == null
                ? "no usable lift"
                : forecast.usableLiftTopM < forecast.launchM
                  ? `usable top ${forecast.usableLiftTopM.toLocaleString("en-CA")} m · below launch`
                  : `usable top ${forecast.usableLiftTopM.toLocaleString("en-CA")} m`}
            </text>
            {forecast.cloudBaseM != null && <text x={center} y="566" class="metric-detail">cloud base {forecast.cloudBaseM.toLocaleString("en-CA")} m</text>}
            {forecast.precipitationMm != null && <text x={center} y="566" class="metric-detail">precip {forecast.precipitationMm.toFixed(2)} mm / 3 h</text>}
          </g>
        );
      })}
    </svg>
  </div>

  <div class="scale-scroll" tabindex="0" aria-label="Scrollable eight-class stability scale">
    <ol class="stability-scale">
      {stabilityClasses.map((entry) => (
        <li>
          <span class={`scale-swatch ${entry.className}`} aria-hidden="true">
            <i class={`hatch ${entry.className}`}></i>
          </span>
          <strong>{entry.label}</strong>
          <span>{entry.threshold}</span>
        </li>
      ))}
    </ol>
    <p class="scale-unit">Thresholds in °C / 1,000 ft</p>
  </div>

  <figcaption id="stability-guide-caption">
    Colour names describe the sampled lapse interval, not the whole day. Read from launch upward:
    deep warm bands support mixing; blue-grey bands and positive values expose stable layers and inversions.
    <span class="source-note">Fixed archived samples: GFS 2026-08-08 15Z; HRDPS 2026-08-08 21Z; GFS 2026-08-14 18Z; GDPS 2026-08-13 21Z.</span>
  </figcaption>
</figure>

<style>
  .stability-guide {
    width: min(1080px, calc(100vw - 32px));
    margin: 28px 50% 44px;
    transform: translateX(-50%);
    color: var(--ink);
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--rule-strong);
  }
  header {
    display: grid;
    grid-template-columns: minmax(220px, .7fr) minmax(340px, 1.3fr);
    gap: 4px 34px;
    align-items: end;
    padding: 20px 0 17px;
  }
  h3 {
    margin: 0;
    font: 700 28px/1 var(--display);
    text-transform: uppercase;
  }
  header > p:last-child {
    margin: 0;
    max-width: 62ch;
    font-size: 13px;
    color: var(--ink-soft);
  }
  .profile-scroll, .scale-scroll { overflow-x: auto; scrollbar-color: var(--accent) var(--surface-raised); }
  .profile-scroll {
    background: var(--surface);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  svg { display: block; width: 100%; min-width: 930px; height: auto; }
  .altitude-grid line { stroke: var(--rule); stroke-width: .8; stroke-dasharray: 2 5; }
  .altitude-grid text, .model-time, .case-note, .lapse-value, .height-note, .metric, .metric-detail {
    font-family: var(--mono);
  }
  .altitude-grid text { fill: var(--ink-mute); font-size: 12px; text-anchor: end; }
  .scenario-name { fill: var(--ink); font: 700 20px var(--display); text-anchor: middle; text-transform: uppercase; }
  .model-time { fill: var(--ink-mute); font-size: 11.5px; text-anchor: middle; }
  .case-note { fill: var(--accent-strong); font-size: 12px; font-weight: 700; text-anchor: middle; }
  .stability-fill { stroke: var(--ink); stroke-width: 1; }
  .pattern-overlay { pointer-events: none; }
  .pattern-line { stroke: var(--ink); stroke-width: 1.1; opacity: .28; }
  .pattern-line.light { stroke-width: .7; opacity: .18; }
  .pattern-line.density-1 { stroke-width: 1.7; }
  .pattern-line.density-2 { stroke-dasharray: 2 3; }
  .pattern-line.density-3 { stroke-width: 2.2; opacity: .22; }
  .very-unstable { fill: var(--stab-very-unstable); background: var(--stab-very-unstable); }
  .unstable { fill: var(--stab-unstable); background: var(--stab-unstable); }
  .conditional-strong { fill: var(--stab-conditional-strong); background: var(--stab-conditional-strong); }
  .conditional { fill: var(--stab-conditional); background: var(--stab-conditional); }
  .near-neutral { fill: var(--stab-near-neutral); background: var(--stab-near-neutral); }
  .stable { fill: var(--stab-stable); background: var(--stab-stable); }
  .inverted { fill: var(--stab-inverted); background: var(--stab-inverted); }
  .strong-inversion { fill: var(--stab-strong-inversion); background: var(--stab-strong-inversion); }
  .lapse-value {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 700;
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 2.4px;
  }
  .launch-marker { stroke: var(--ink); stroke-width: 1.5; stroke-dasharray: 2 3; }
  .launch-arrow { fill: var(--ink); }
  .usable-marker { stroke: var(--chart-usable); stroke-width: 3; }
  .height-note { fill: var(--ink); font-size: 10.5px; font-weight: 700; paint-order: stroke; stroke: var(--surface); stroke-width: 2.5px; }
  .metric { fill: var(--ink); font-size: 12px; font-weight: 700; text-anchor: middle; }
  .metric-detail { fill: var(--ink-mute); font-size: 11px; text-anchor: middle; }
  .scale-scroll { padding: 15px 0 11px; }
  .stability-scale {
    min-width: 850px;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stability-scale li { min-width: 0; border-left: 1px solid var(--rule); }
  .stability-scale li:first-child { border-left: 0; }
  .scale-swatch { position: relative; display: block; height: 12px; border-block: 1px solid var(--ink); overflow: hidden; }
  .hatch {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(120deg, transparent 0 5px, rgb(21 37 41 / .4) 5px 6px);
  }
  .stability-scale strong, .stability-scale li > span:last-child {
    display: block;
    padding-inline: 7px;
    font-family: var(--mono);
  }
  .stability-scale strong { margin-top: 7px; font-size: 10.5px; line-height: 1.25; color: var(--ink); }
  .stability-scale li > span:last-child { margin-top: 2px; font-size: 11px; color: var(--ink-mute); }
  .scale-unit { margin: 8px 0 0; font: 11px var(--mono); color: var(--ink-mute); }
  figcaption { padding: 11px 0 13px; font: 12px/1.5 var(--mono); color: var(--ink-soft); }
  .source-note { display: block; margin-top: 5px; font-size: 10.5px; color: var(--ink-mute); }
  @media (max-width: 720px) {
    header { grid-template-columns: 1fr; }
    h3 { font-size: 24px; }
    .profile-scroll, .scale-scroll { margin-inline: -8px; padding-inline: 8px; }
    svg { min-width: 920px; }
  }
</style>
