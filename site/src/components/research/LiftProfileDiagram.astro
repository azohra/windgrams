      <text x="66" y="53" text-anchor="end">1.17</text>
      <text x="278" y="402" text-anchor="middle">UPDRAFT / w* →</text>
      <text transform="translate(18 196) rotate(-90)" text-anchor="middle">HEIGHT / D →</text>
    </g>
  </svg>
  </div>
  <figcaption id="lift-profile-caption">
    Schematic, not a forecast trace. The horizontal position is updraft normalized by w*; the
    crossing depends on the hour’s actual w* and the 1 m/s sink criterion.
  </figcaption>
</figure>

<style>
  .lift-profile {
    width: min(920px, calc(100vw - 48px));
    margin: 28px 50% 44px;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: minmax(230px, 0.78fr) minmax(400px, 1.22fr);
    gap: 24px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--rule);
  }
  .profile-copy { align-self: center; }
  .profile-copy h3 {
    margin: 0 0 12px;
    font-family: var(--display);
    font-size: 25px;
    line-height: 1;
    text-transform: uppercase;
  }
  .profile-copy > p { margin: 0; font-size: 13px; color: var(--ink-soft); }
  .formula-pair { display: grid; gap: 8px; margin-top: 20px; }
  .formula-pair span { display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12px; color: var(--ink-mute); }
  .formula-pair i { width: 22px; border-top: 2px solid; }
  .formula-pair b { color: var(--ink); }
  .average-key { border-color: var(--model-1); }
  .core-key { border-color: var(--accent); }
  .mobile-readout { display: none; }
  .profile-chart { min-width: 0; overflow-x: auto; scrollbar-color: var(--accent) var(--surface-raised); }
  svg { display: block; width: 100%; height: auto; }
  .grid line { stroke: var(--rule); stroke-width: 1; }
  .axis { stroke: var(--ink-mute); stroke-width: 1.2; }
  .threshold { stroke: var(--status-serious); stroke-width: 1.25; stroke-dasharray: 5 4; }
  .bl-top { stroke: var(--ink-soft); stroke-width: 1; stroke-dasharray: 2 5; }
  .average-line, .core-line { fill: none; stroke-width: 2.5; }
  .average-line { stroke: var(--model-1); }
  .average-line { stroke-dasharray: 7 4; }
  .core-line { stroke: var(--accent); }
  .average-dot { fill: var(--model-1); }
  .core-dot { fill: var(--accent); }
  .callout { stroke: var(--ink-mute); stroke-width: 1; }
  .label-scrim { fill: var(--surface); opacity: 0.95; }
  .annotation, .bl-label, .axis-text { font-family: var(--mono); font-size: 12px; fill: var(--ink); }
  .annotation.subtle, .bl-label, .axis-text { fill: var(--ink-mute); }
  figcaption { grid-column: 1 / -1; margin: -2px 0 0; font-family: var(--mono); font-size: 12px; color: var(--ink-mute); }
  @media (max-width: 760px) {
    .lift-profile { width: min(100%, calc(100vw - 32px)); grid-template-columns: 1fr; gap: 16px; padding: 17px; }
    .profile-copy h3 { font-size: 24px; }
    .mobile-readout { display: grid; gap: 6px; padding-block: 2px 7px; border-bottom: 1px solid var(--rule); }
    .mobile-readout p { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; margin: 0; font: 11px/1.35 var(--mono); color: var(--ink-mute); }
    .mobile-readout p span { color: var(--ink); }
    .mobile-readout p strong { display: grid; justify-items: end; font-weight: 400; }
    .mobile-readout p b { font-size: 14px; color: var(--ink); }
    .mobile-readout p small { font-size: 10px; white-space: nowrap; }
    .mobile-readout span::before { content: ""; display: inline-block; width: 18px; margin-right: 7px; border-top: 2px solid; vertical-align: .2em; }
    .mobile-readout .average-mark::before { border-color: var(--model-1); border-top-style: dashed; }
    .mobile-readout .core-mark::before { border-color: var(--accent); }
    .mobile-readout .threshold-mark::before { border-color: var(--status-serious); border-top-style: dashed; }
    .profile-chart { margin-inline: -4px; }
    .profile-chart::before { content: "Scroll chart horizontally →"; display: block; margin: 2px 4px 4px; font: 10.5px var(--mono); color: var(--ink-mute); }
    svg { width: 520px; max-width: none; }
  }
</style>
