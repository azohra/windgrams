---
import type { TocEntry } from "../../lib/research";

interface Props {
  toc: TocEntry[];
}
const { toc } = Astro.props;
---

<nav class="doc-toc" aria-label="Sections on this page">
  <p class="doc-toc-label">On this page</p>
  <ol>
    {
      toc.map((entry) => (
        <li>
          <a href={`#${entry.id}`}>{entry.text}</a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .doc-toc {
    margin: 22px 0 36px;
    padding: 14px 18px 16px;
    background: var(--surface);
    border: 1px solid var(--rule);
  }
  .doc-toc-label {
    margin: 0 0 8px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .doc-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 2px;
    counter-reset: toc;
  }
  .doc-toc li {
    counter-increment: toc;
    font-size: 13.5px;
  }
  .doc-toc li::before {
    content: counter(toc, decimal-leading-zero) " ";
    font-family: var(--mono);
    color: var(--ink-mute);
    font-size: 12px;
    margin-right: 6px;
  }
  .doc-toc a {
    color: var(--ink-soft);
    display: inline;
    padding: 3px 0;
  }
  .doc-toc a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  @media (max-width: 560px) {
    .doc-toc ol {
      grid-template-columns: 1fr;
    }
  }
</style>
